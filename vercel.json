{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "{config.json,public/**,auth/**}"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
